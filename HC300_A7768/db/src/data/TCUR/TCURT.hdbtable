COLUMN TABLE "HC::TCURT" (
    "MANDT" NVARCHAR(3) DEFAULT '000' NOT NULL      COMMENT 'Client',
    "SPRAS" NVARCHAR(1) DEFAULT ' ' NOT NULL        COMMENT 'Language Key',
    "WAERS" NVARCHAR(5) DEFAULT ' ' NOT NULL        COMMENT 'Currency Key',
    "LTEXT" NVARCHAR(40) DEFAULT ' ' NOT NULL       COMMENT 'Long Text',
    "KTEXT" NVARCHAR(15) DEFAULT ' ' NOT NULL       COMMENT 'Short text',
    PRIMARY KEY ("MANDT", "SPRAS", "WAERS")
    )
UNLOAD PRIORITY 5  AUTO MERGE
COMMENT 'Currency Code Names';